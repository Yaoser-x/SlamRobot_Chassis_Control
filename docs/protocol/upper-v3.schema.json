{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "F407 Upper Protocol v3 wire contract",
  "protocol_version": 3,
  "byte_order": "little-endian",
  "frame": {
    "header_hex": "a55a",
    "length_offset": 2,
    "length_semantics": "CMD plus PAYLOAD bytes",
    "command_offset": 3,
    "payload_offset": 4,
    "checksum": "CRC-8/MAXIM over LEN, CMD and PAYLOAD",
    "max_payload_length": 99
  },
  "session": {
    "scope": "per-link",
    "links": ["Host USART3", "ESP USART2"],
    "retired_capacity_per_link": 8,
    "retired_lifetime": "current MCU boot only",
    "new_session_rule": "only enable=0 may establish a previously unseen session",
    "sequence_rule": "forward iff 0 < uint32(new-old) < 2^31",
    "duplicate_rule": "same sequence and identical target is keepalive only",
    "safety_rearm_rule": "after a safety gate close, a newer disable sequence must be applied before enable"
  },
  "messages": {
    "SET_VELOCITY": {
      "command": 1,
      "payload_length": 23,
      "direction": "to-firmware",
      "owner": "Communication validates session; CommandManagement applies target",
      "update_frequency": "50 ms keepalive while active; Host lease 200 ms; ESP lease 500 ms",
      "retransmission": "identical sequence and identical target may refresh an existing live lease",
      "fields": [
        {"name":"protocol_version","offset":0,"width":1,"type":"u8","unit":"none","range":"3","invalid":"not 3","owner":"Communication"},
        {"name":"linear_x","offset":1,"width":4,"type":"f32","unit":"m/s","range":"finite, clamped by parameters","invalid":"NaN or infinity","owner":"CommandManagement"},
        {"name":"angular_z","offset":5,"width":4,"type":"f32","unit":"rad/s","range":"finite, clamped by parameters","invalid":"NaN or infinity","owner":"CommandManagement"},
        {"name":"enable","offset":9,"width":1,"type":"u8","unit":"boolean","range":"0..1","invalid":"other","owner":"Communication"},
        {"name":"mode","offset":10,"width":1,"type":"u8","unit":"enum","range":"2","invalid":"not 2","owner":"Communication"},
        {"name":"session_id","offset":11,"width":8,"type":"u64","unit":"opaque","range":"1..2^64-1","invalid":"0","owner":"Communication"},
        {"name":"sequence","offset":19,"width":4,"type":"u32","unit":"counter","range":"0..2^32-1","invalid":null,"owner":"Communication"}
      ]
    },
    "ESTOP": {"command":2,"payload_length":2,"direction":"to-firmware","owner":"SafetyManagement","update_frequency":"event","retransmission":"idempotent set-only request","fields":[{"name":"protocol_version","offset":0,"width":1,"type":"u8","unit":"none","range":"3","invalid":"not 3","owner":"Communication"},{"name":"set","offset":1,"width":1,"type":"u8","unit":"boolean","range":"1","invalid":"0 cannot clear ESTOP","owner":"SafetyManagement"}]},
    "LINE_CTRL": {"command":3,"payload_length":2,"direction":"to-firmware","owner":"LineFollowing","update_frequency":"event","retransmission":"v3 reports queued only; observe Service state","fields":[{"name":"protocol_version","offset":0,"width":1,"type":"u8","unit":"none","range":"3","invalid":"not 3","owner":"Communication"},{"name":"enabled","offset":1,"width":1,"type":"u8","unit":"boolean","range":"0..1","invalid":"other","owner":"LineFollowing"}]},
    "CLEAR_FAULT": {"command":4,"payload_length":1,"direction":"to-firmware","owner":"SafetyManagement","update_frequency":"event","retransmission":"v3 reports queued only; no wire business result","fields":[{"name":"protocol_version","offset":0,"width":1,"type":"u8","unit":"none","range":"3","invalid":"not 3","owner":"Communication"}]},
    "GET_INFO": {"command":5,"payload_length":1,"direction":"to-firmware","owner":"Communication","update_frequency":"on connect and retry","retransmission":"safe","fields":[{"name":"protocol_version","offset":0,"width":1,"type":"u8","unit":"none","range":"3","invalid":"not 3","owner":"Communication"}]},
    "HELLO": {
      "command":128,"payload_length":34,"direction":"from-firmware","owner":"Communication","update_frequency":"on GET_INFO","retransmission":"new frame, same build identity",
      "fields":[
        {"name":"protocol_version","offset":0,"width":1,"type":"u8","unit":"none","range":"3","invalid":"not 3","owner":"Communication"},
        {"name":"schema_version","offset":1,"width":1,"type":"u8","unit":"none","range":"1","invalid":"not 1","owner":"Communication"},
        {"name":"capabilities","offset":2,"width":4,"type":"u32","unit":"bitmask","range":"defined capability bits","invalid":"missing required bits","owner":"Communication"},
        {"name":"git_commit","offset":6,"width":20,"type":"bytes","unit":"raw SHA-1","range":"20 bytes","invalid":"all zero means untrusted build","owner":"build system"},
        {"name":"hardware_revision","offset":26,"width":4,"type":"u32","unit":"revision","range":"0x00020000 for F407 V2","invalid":"0","owner":"App identity provider"},
        {"name":"parameter_crc32","offset":30,"width":4,"type":"u32","unit":"CRC32","range":"0..2^32-1","invalid":null,"owner":"ParameterManagement"}
      ]
    },
    "STATUS": {
      "command":129,"payload_length":92,"direction":"from-firmware","owner":"Communication serializes App coherent snapshot","update_frequency":"configured periodic publication","retransmission":"reusing a snapshot must not alter status_sequence or timestamp_ms",
      "fields":[
        {"name":"protocol_version","offset":0,"width":1,"type":"u8","unit":"none","range":"3","invalid":"not 3","owner":"Communication"},
        {"name":"status_flags","offset":1,"width":1,"type":"u8","unit":"bitmask","range":"defined bits only","invalid":"undefined bits must be ignored","owner":"Safety/Line/StateEstimation"},
        {"name":"control_source","offset":2,"width":1,"type":"u8","unit":"enum","range":"0..5","invalid":"other","owner":"CommandManagement"},
        {"name":"motor_enabled_mask","offset":3,"width":1,"type":"u8","unit":"bitmask LF/LR/RF/RR","range":"0x00..0x0f","invalid":"upper bits","owner":"hardware layout"},
        {"name":"error_flags","offset":4,"width":4,"type":"u32","unit":"bitmask","range":"defined system errors","invalid":null,"owner":"SafetyManagement"},
        {"name":"latched_error_flags","offset":8,"width":4,"type":"u32","unit":"bitmask","range":"defined system errors","invalid":null,"owner":"SafetyManagement"},
        {"name":"battery_mv","offset":12,"width":2,"type":"u16","unit":"mV","range":"0..65535","invalid":"quality supplied by diagnostic","owner":"PowerManagement"},
        {"name":"motor_speed_mmps","offset":14,"width":8,"type":"i16[4]","unit":"mm/s","range":"-32768..32767 each","invalid":"mask bit clear","owner":"StateEstimation"},
        {"name":"encoder_count","offset":22,"width":16,"type":"i32[4]","unit":"count","range":"-2^31..2^31-1 each","invalid":"disabled wheel is not participating","owner":"StateEstimation"},
        {"name":"motor_current_ma","offset":38,"width":8,"type":"u16[4]","unit":"mA","range":"0..65535 each","invalid":"diagnostic ADC validity","owner":"PowerManagement"},
        {"name":"motor_target_mmps","offset":46,"width":8,"type":"i16[4]","unit":"mm/s","range":"-32768..32767 each","invalid":null,"owner":"MotionControl"},
        {"name":"motor_output_permille","offset":54,"width":8,"type":"i16[4]","unit":"permille","range":"-1000..1000 each","invalid":null,"owner":"MotionControl"},
        {"name":"motor_speed_valid_mask","offset":62,"width":1,"type":"u8","unit":"bitmask LF/LR/RF/RR","range":"subset of motor_enabled_mask","invalid":"bit set for disabled wheel","owner":"StateEstimation"},
        {"name":"encoder_anomaly_mask","offset":63,"width":1,"type":"u8","unit":"bitmask LF/LR/RF/RR","range":"0x00..0x0f","invalid":"upper bits","owner":"StateEstimation"},
        {"name":"comm_health_flags","offset":64,"width":1,"type":"u8","unit":"bitmask","range":"defined bits","invalid":"undefined bits ignored","owner":"Communication"},
        {"name":"status_sequence","offset":65,"width":4,"type":"u32","unit":"snapshot generation","range":"0..2^32-1","invalid":null,"owner":"App snapshot collector"},
        {"name":"timestamp_ms","offset":69,"width":4,"type":"u32","unit":"ms","range":"boot-relative","invalid":null,"owner":"App snapshot collector"},
        {"name":"session_id","offset":73,"width":8,"type":"u64","unit":"opaque","range":"link-local active session or 0","invalid":null,"owner":"Communication"},
        {"name":"received_sequence","offset":81,"width":4,"type":"u32","unit":"counter","range":"0..2^32-1","invalid":null,"owner":"Communication"},
        {"name":"applied_sequence","offset":85,"width":4,"type":"u32","unit":"counter","range":"0..2^32-1","invalid":null,"owner":"Communication"},
        {"name":"reject_reason","offset":89,"width":1,"type":"u8","unit":"enum","range":"0..8","invalid":"other","owner":"Communication"},
        {"name":"side_consistency_flags","offset":90,"width":1,"type":"u8","unit":"bitmask","range":"defined side bits","invalid":"undefined bits ignored","owner":"StateEstimation"},
        {"name":"ack_flags","offset":91,"width":1,"type":"u8","unit":"bitmask","range":"defined ACK bits","invalid":"undefined bits ignored","owner":"Communication"}
      ]
    },
    "DIAGNOSTIC": {"command":130,"payload_length":28,"direction":"from-firmware","owner":"App snapshot and Services","update_frequency":"configured periodic publication","retransmission":"latest snapshot","fields":[{"name":"protocol_version","offset":0,"width":1,"type":"u8","unit":"none","range":"3","invalid":"not 3","owner":"Communication"},{"name":"schema_version","offset":1,"width":1,"type":"u8","unit":"none","range":"1","invalid":"not 1","owner":"Communication"},{"name":"post_done","offset":2,"width":1,"type":"u8","unit":"boolean","range":"0..1","invalid":"other","owner":"POST"},{"name":"imu_status_flags","offset":3,"width":1,"type":"u8","unit":"bitmask","range":"defined bits","invalid":null,"owner":"StateEstimation"},{"name":"post_error_flags","offset":4,"width":4,"type":"u32","unit":"bitmask","range":"defined bits","invalid":null,"owner":"POST"},{"name":"adc_invalid_reason_flags","offset":8,"width":4,"type":"u32","unit":"bitmask","range":"defined bits","invalid":null,"owner":"PowerManagement"},{"name":"task_timeout_mask","offset":12,"width":2,"type":"u16","unit":"bitmask","range":"defined tasks","invalid":null,"owner":"SystemMonitoring"},{"name":"reserved","offset":14,"width":2,"type":"bytes","unit":"none","range":"all zero","invalid":"nonzero","owner":"Communication"},{"name":"imu_quality_flags","offset":16,"width":4,"type":"u32","unit":"bitmask","range":"defined bits","invalid":null,"owner":"StateEstimation"},{"name":"reset_reason_flags","offset":20,"width":4,"type":"u32","unit":"bitmask","range":"defined bits","invalid":null,"owner":"Platform"},{"name":"uptime_ms","offset":24,"width":4,"type":"u32","unit":"ms","range":"boot-relative","invalid":null,"owner":"Platform"}]},
    "IMU_STATUS": {"command":131,"payload_length":99,"direction":"from-firmware","owner":"StateEstimation","update_frequency":"configured periodic publication","retransmission":"latest snapshot","fields":[{"name":"protocol_version","offset":0,"width":1,"type":"u8","unit":"none","range":"3","invalid":"not 3","owner":"Communication"},{"name":"accel_g","offset":1,"width":12,"type":"f32[3]","unit":"g","range":"finite","invalid":"quality flags","owner":"StateEstimation"},{"name":"gyro_corrected_dps","offset":13,"width":12,"type":"f32[3]","unit":"deg/s","range":"finite","invalid":"quality flags","owner":"StateEstimation"},{"name":"euler_deg","offset":25,"width":12,"type":"f32[3]","unit":"deg","range":"finite","invalid":"quality flags","owner":"StateEstimation"},{"name":"quaternion","offset":37,"width":16,"type":"f32[4]","unit":"none","range":"finite normalized when valid","invalid":"quality flags","owner":"StateEstimation"},{"name":"timestamp_ms","offset":53,"width":4,"type":"u32","unit":"ms","range":"boot-relative","invalid":null,"owner":"StateEstimation"},{"name":"sensor_time","offset":57,"width":4,"type":"u32","unit":"sensor ticks","range":"0..2^32-1","invalid":"status flag clear","owner":"StateEstimation"},{"name":"sample_count","offset":61,"width":4,"type":"u32","unit":"count","range":"0..2^32-1","invalid":null,"owner":"StateEstimation"},{"name":"quality_flags","offset":65,"width":4,"type":"u32","unit":"bitmask","range":"defined bits","invalid":null,"owner":"StateEstimation"},{"name":"quality_counters","offset":69,"width":28,"type":"u32[7]","unit":"count","range":"0..2^32-1 each","invalid":null,"owner":"StateEstimation"},{"name":"status_flags","offset":97,"width":1,"type":"u8","unit":"bitmask","range":"defined bits","invalid":"undefined bits ignored","owner":"StateEstimation"},{"name":"temperature_c","offset":98,"width":1,"type":"i8","unit":"degC","range":"-128..127","invalid":"status error bit","owner":"StateEstimation"}]}
  },
  "status_flags": {"ESTOP":1,"FAULT_STOP":2,"LINE_ENABLED":4,"SPEED_VALID_ALL":8},
  "ack_flags": {"SESSION_VALID":1,"RECEIVED":2,"APPLIED":4,"DUPLICATE":8,"REJECTED":16},
  "reject_reasons": {"NONE":0,"MALFORMED":1,"UNSUPPORTED_VERSION":2,"NONFINITE":3,"INVALID_MODE":4,"STALE_SESSION":5,"OUT_OF_ORDER":6,"FAULT":7,"SOURCE_NOT_PERMITTED":8}
}
